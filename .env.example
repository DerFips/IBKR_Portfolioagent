OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma4:e4b
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_DRY_RUN=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8888
# PFLICHT: ohne Passwort ist das Dashboard gesperrt
DASHBOARD_PASSWORD=
DB_PATH=data/portfolio.db
AGENT_RUN_HOUR=17
AGENT_RUN_MINUTE=5
MAX_POSITION_PCT=10.0
MAX_DAILY_TRADES=5
MIN_CONFIDENCE=0.65
# KI-Provider: ollama (lokal) oder anthropic (Claude API)
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OLLAMA_TIMEOUT=600
# NVIDIA NIM (LLM_PROVIDER=nvidia) – Key von build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Websuche fuer Ollama/NVIDIA (tavily.com, 1000 Credits/Monat gratis laut Tavily-Doku)
TAVILY_API_KEY=
# Hermes Agent (LLM_PROVIDER=hermes): 'hermes gateway' mit API_SERVER_ENABLED=true, Port 8642
HERMES_BASE_URL=http://host.docker.internal:8642/v1
HERMES_API_KEY=
# Risiko / Ordergroesse (Stueckzahl = Depot * MAX_RISK_PCT_PER_TRADE / STOP_LOSS_PCT, begrenzt durch Positionslimit und Cash)
MAX_RISK_PCT_PER_TRADE=1.0
STOP_LOSS_PCT=10
BENCHMARK_SYMBOL=SPY
# Datenbank-Backup
BACKUP_ENABLED=true
BACKUP_HOUR=3
BACKUP_KEEP=14
# Optional: eigener Schluessel fuer verschluesselte Einstellungen (sonst data/.settings.key, wird automatisch angelegt)
# SETTINGS_ENCRYPTION_KEY=
